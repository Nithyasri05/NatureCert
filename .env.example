# Environment variable examples for Mini proj -2
# Copy to .env and fill values before running `npm run dev`.

# Database (Postgres / Neon / Supabase)
# Example: postgres://user:password@localhost:5432/mydb
DATABASE_URL='postgresql://<username>:<password>@<host>:<port>/<db>?sslmode=require'

# Drizzle / DB push (if used)
# DRIZZLE_URL=

# API / frontend
VITE_API_URL=http://localhost:5000

# JWT / Auth
JWT_SECRET=

# Storage (if used)
STORAGE_PROVIDER=
STORAGE_BUCKET=
STORAGE_KEY=
STORAGE_SECRET=

# OpenAI (if used)
OPENAI_API_KEY='sk-REPLACE_WITH_YOUR_KEY'

# Notes:
# - This project requires a Postgres-compatible DATABASE_URL for full functionality.
# - For local development, you can run a local Postgres instance (Docker or native),
#   or use a hosted provider (Supabase, Neon, Heroku) and paste its connection string here.


#  $env:DATABASE_URL =  'postgresql://<username>:<password>@<host>:<port>/<db>?sslmode=require'      
# >> $env:OPENAI_API_KEY = 'sk-REPLACE_WITH_YOUR_KEY'                                                           
# >> npm run dev    